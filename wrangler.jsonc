{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todome",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The React app. Unknown paths fall back to index.html; only /api/* runs the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // No database_id: wrangler creates the database on first deploy.
    { "binding": "DB", "database_name": "todome" }
  ],
  "observability": { "enabled": true }
}
